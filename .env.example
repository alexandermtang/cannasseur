# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> Data API
#
# Both values are embedded in the app bundle and are NOT secret. That is expected:
# the anon key is designed to be public and is gated by the row-level security
# policies in supabase/schema.sql.
#
# The `service_role` key must NEVER go in here or anywhere else in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
